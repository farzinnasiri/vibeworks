{
  "name": "vibeworks-cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n bridge,web \"pnpm run dev:bridge\" \"pnpm run dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:bridge": "tsx src/bridge/server.ts",
    "mcp": "tsx src/bridge/mcp.ts",
    "cad": "tsx src/bridge/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "demo:mcp": "tsx scripts/mcp-demo.ts",
    "demo:mechanical": "tsx scripts/mechanical-demo.ts",
    "headless": "tsx src/bridge/server.ts",
    "renderer:install": "playwright install chromium --only-shell",
    "verify:headless": "tsx scripts/verify-headless.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "esbuild": "0.27.3",
    "oidn-webgpu": "0.6.0",
    "playwright": "1.58.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16",
    "ws": "8.22.0",
    "xatlas-web": "0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "occt-import-js": "0.0.23",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "description": "Agent-first CAD for mechanical design, with a shared human review workspace.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farzinnasiri/vibeworks.git"
  },
  "homepage": "https://github.com/farzinnasiri/vibeworks#readme",
  "bugs": {
    "url": "https://github.com/farzinnasiri/vibeworks/issues"
  },
  "packageManager": "pnpm@12.16.1"
}
